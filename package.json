{
  "name": "silinx-ise",
  "version": "15.10.0",
  "description": "Silinx ISE (Integrated Synthesis Environment): HDL design platform in the style of Xilinx ISE 14.x: VHDL/Verilog projects, schematic and ASM editors, behavioural simulation, ISE 14.7 implementation and board programming",
  "type": "module",
  "bin": {
    "silinx-ise": "bin/silinx-ise.js"
  },
  "scripts": {
    "start": "node bin/silinx-ise.js serve",
    "test": "node --test test/*.test.js",
    "test:ui": "node --test test/ui/*.test.js",
    "test:ise": "SILINX_ISE_TESTS=1 node --test test/ise/*.test.js",
    "test:webkit": "node --test test/webkit/*.test.js",
    "build:standalone": "node scripts/build-standalone.mjs",
    "version": "node scripts/sync-version.mjs && git add core/version.js"
  },
  "license": "AGPL-3.0-only",
  "dependencies": {
    "codemirror": "^5.65.21",
    "elkjs": "^0.9.3",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "esbuild": "^0.24.2",
    "playwright": "1.49.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pmnmalo/Silinx-ISE.git"
  },
  "author": "Pedro Maló"
}
